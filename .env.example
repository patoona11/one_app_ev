# ==============================================================================
# App_EV Thailand - Environment Variables Example
# ห้ามใส่ Secret หรือ API Key จริงลงในเวอร์ชันสาธารณะ (Never store real secrets here)
# ==============================================================================

# Server Configuration
PORT=3001
NODE_ENV=development

# JWT Secret for Authentication & Role-Based Security
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Database Configuration (SQLite path or PostgreSQL connection string in production)
DATABASE_URL=./database/ev_thailand.db

# Routing Service Provider (OSRM | GRAPHHOPPER | OPENROUTESERVICE)
ROUTING_PROVIDER=OSRM
OSRM_BASE_URL=https://router.project-osrm.org/route/v1

# API Key for GraphHopper or OpenRouteService (if ROUTING_PROVIDER is switched)
ROUTING_API_KEY=your_routing_service_api_key_if_applicable

# Overpass API Backup Endpoints (Comma-separated for automated fallback)
OVERPASS_ENDPOINTS=https://overpass.openstreetmap.fr/api,https://overpass-api.de/api,https://overpass.kumi.systems/api

# Frontend URL for CORS Policy
CORS_ORIGIN=http://localhost:5173
